<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType Condition="'$(NoriIsWindowsBuild)' == 'true'">WinExe</OutputType>
		<OutputType Condition="'$(NoriIsWindowsBuild)' != 'true'">Exe</OutputType>
		<RootNamespace>Nori.AppLauncher</RootNamespace>
		<AssemblyName>Nori</AssemblyName>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../Nori.Startup/LinuxStartupError.cs" Link="Startup/LinuxStartupError.cs" />
		<InternalsVisibleTo Include="Nori.AppLauncher.Tests" />
	</ItemGroup>

</Project>
