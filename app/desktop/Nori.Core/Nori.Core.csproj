<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Nori.Core</RootNamespace>
		<AssemblyName>Nori.Core</AssemblyName>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);OPENAI001;MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nori.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11"/>
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0"/>
		<PackageReference Include="ModelContextProtocol.Core" Version="2.2.0"/>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0"/>
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0"/>
		<PackageReference Include="OpenAI" Version="2.12.0"/>
		<PackageReference Include="Anthropic" Version="12.42.0"/>
		<PackageReference Include="Google.GenAI" Version="1.19.0"/>
		<PackageReference Include="AngleSharp" Version="1.7.1"/>
		<PackageReference Include="YamlDotNet" Version="18.1.0"/>
		<PackageReference Include="NLog" Version="6.2.0"/>
		<PackageReference Include="Cronos" Version="0.13.0"/>
		<PackageReference Include="System.Numerics.Tensors" Version="10.0.11"/>
	</ItemGroup>

	<ItemGroup>
		<!-- 本机回环资源服务 (AssetServer) 用 Kestrel: HttpListener 在非管理员下绑端口需要 urlacl -->
		<FrameworkReference Include="Microsoft.AspNetCore.App"/>
	</ItemGroup>

	<ItemGroup>
		<!-- 人格提示词编译进程序集, 与 Rust 版 include_str! 等价: 改了必须重新构建才生效 -->
		<EmbeddedResource Include="Chat/nori-system-prompt.md" LogicalName="Nori.Core.Chat.nori-system-prompt.md"/>
		<EmbeddedResource Include="Memory.md" LogicalName="Nori.Core.Memory.md"/>
	</ItemGroup>

</Project>
