<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Nori.Core</RootNamespace>
		<AssemblyName>Nori.Core</AssemblyName>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoWarn>$(NoWarn);OPENAI001;MEAI001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nori.Core.Tests" />
		<InternalsVisibleTo Include="Nori.Desktop.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11"/>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11"/>
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0"/>
		<PackageReference Include="ModelContextProtocol.Core" Version="2.2.0"/>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0"/>
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0"/>
		<PackageReference Include="OpenAI" Version="2.12.0"/>
		<PackageReference Include="Anthropic" Version="12.42.0"/>
		<PackageReference Include="Google.GenAI" Version="1.19.0"/>
		<PackageReference Include="AngleSharp" Version="1.7.1"/>
		<PackageReference Include="YamlDotNet" Version="18.1.0"/>
		<PackageReference Include="NLog" Version="6.2.0"/>
		<PackageReference Include="Cronos" Version="0.13.0"/>
		<PackageReference Include="System.Numerics.Tensors" Version="10.0.11"/>
	</ItemGroup>

	<PropertyGroup>
		<NoriUdaRid>$(RuntimeIdentifier)</NoriUdaRid>
		<NoriUdaRid Condition="'$(NoriUdaRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</NoriUdaRid>
		<NoriUdaPath Condition="'$(NoriUdaRid)' == 'linux-x64'">../UniDesktop/native/linux-x64/libuda_ffi.so</NoriUdaPath>
		<NoriUdaPath Condition="'$(NoriUdaRid)' == 'win-x64'">../UniDesktop/native/win-x64/uda_ffi.dll</NoriUdaPath>
	</PropertyGroup>
	<ItemGroup Condition="'$(NoriUdaPath)' != '' And Exists('$(NoriUdaPath)')">
		<None Include="$(NoriUdaPath)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<None Include="../UniDesktop/LICENSE-MIT" Link="UniDesktop.LICENSE-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<!-- 人格提示词编译进程序集：修改后必须重新构建才生效 -->
		<EmbeddedResource Include="Chat/nori-system-prompt.md" LogicalName="Nori.Core.Chat.nori-system-prompt.md"/>
		<EmbeddedResource Include="Memory.md" LogicalName="Nori.Core.Memory.md"/>
	</ItemGroup>

</Project>
