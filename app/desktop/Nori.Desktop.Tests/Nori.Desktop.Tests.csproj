<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Headless" Version="12.1.1" />
		<PackageReference Include="coverlet.collector" Version="6.0.4" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<!--
		设置窗口的主题文件在构建时嵌进来, 供 SettingsNavigationTests 核对导航图标。

		走嵌入而不是运行时找路径: Avalonia 的 .axaml 打在 !AvaloniaResources 那个私有容器里,
		AssetLoader 又要有一个跑起来的 Avalonia 应用才能读 —— 测试宿主里没有。
	-->
	<ItemGroup>
		<EmbeddedResource Include="..\Nori.Desktop\Settings\SettingsTheme.axaml" LogicalName="SettingsTheme.axaml" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nori.Core\Nori.Core.csproj" />
		<ProjectReference Include="..\Nori.Desktop\Nori.Desktop.csproj" />
	</ItemGroup>

</Project>
