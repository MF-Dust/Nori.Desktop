<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- 主界面的按钮只影响当前窗口，保留原生键盘与自动化语义。 -->
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Nori.Desktop/Appearance/NoriThemeResources.g.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<ControlTheme x:Key="MainButtonTheme" TargetType="Button">
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="Foreground" Value="{DynamicResource MainText}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource MainLine}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="CornerRadius" Value="{DynamicResource NoriRadiusSm}"/>
				<Setter Property="Padding" Value="12,8"/>
				<Setter Property="FontSize" Value="{DynamicResource NoriFontBase}"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="HorizontalContentAlignment" Value="Center"/>
				<Setter Property="VerticalContentAlignment" Value="Center"/>
				<Setter Property="Template">
					<ControlTemplate>
						<Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
							<Border Name="HoverSurface" CornerRadius="{TemplateBinding CornerRadius}">
								<Border Name="FocusSurface" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
									<ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
										HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
								</Border>
							</Border>
						</Border>
					</ControlTemplate>
				</Setter>
				<Style Selector="^:pointerover /template/ Border#HoverSurface">
					<Setter Property="Background" Value="{DynamicResource MainHover}"/>
				</Style>
				<Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Opacity" Value="{DynamicResource NoriOpacityPressed}"/>
				</Style>
				<Style Selector="^:focus-visible /template/ Border#FocusSurface">
					<Setter Property="BorderBrush" Value="{DynamicResource MainAccent}"/>
				</Style>
				<Style Selector="^:disabled"><Setter Property="Opacity" Value="{DynamicResource NoriOpacityDisabled}"/></Style>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>
	<Style Selector="Button"><Setter Property="Theme" Value="{StaticResource MainButtonTheme}"/></Style>
	<Style Selector="Button.primary">
		<Setter Property="Background" Value="{DynamicResource MainAccent}"/>
		<Setter Property="Foreground" Value="{DynamicResource MainOnAccent}"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>
</Styles>
