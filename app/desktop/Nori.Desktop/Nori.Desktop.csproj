<Project Sdk="Microsoft.NET.Sdk">

	<!-- 公共编译口径见 ../Directory.Build.props -->
	<PropertyGroup>
		<!-- Windows 上用 WinExe 隐藏控制台窗口; Linux/macOS 上 Exe 才是正常的 GUI 入口 -->
		<OutputType Condition="'$(NoriIsWindowsBuild)' == 'true'">WinExe</OutputType>
		<OutputType Condition="'$(NoriIsWindowsBuild)' != 'true'">Exe</OutputType>
		<RootNamespace>Nori.Desktop</RootNamespace>
		<AssemblyName>Nori.Desktop</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- OPENAI001/MEAI001: 预览版 AI SDK 的实验性 API 标记 -->
		<NoWarn>$(NoWarn);OPENAI001;MEAI001;CS0436</NoWarn>
		<!-- NativeControlHost 需要这份 manifest 声明受支持的 OS, 否则 WebView 启动即失败 (仅 Windows 有意义) -->
		<ApplicationManifest Condition="'$(NoriIsWindowsBuild)' == 'true'">app.manifest</ApplicationManifest>
		<ApplicationIcon Condition="'$(NoriIsWindowsBuild)' == 'true'">Assets/icon.ico</ApplicationIcon>
		<!-- 发布构建可通过 -p:NoriSentry* 或同名环境变量把非秘密 DSN/release 编译进应用。 -->
		<NoriSentryDsnNative Condition="'$(NoriSentryDsnNative)' == ''">$([System.Environment]::GetEnvironmentVariable('NORI_SENTRY_DSN_NATIVE'))</NoriSentryDsnNative>
		<NoriSentryRelease Condition="'$(NoriSentryRelease)' == ''">$([System.Environment]::GetEnvironmentVariable('NORI_SENTRY_RELEASE'))</NoriSentryRelease>
		<NoriSentryEnvironment Condition="'$(NoriSentryEnvironment)' == ''">$([System.Environment]::GetEnvironmentVariable('NORI_SENTRY_ENVIRONMENT'))</NoriSentryEnvironment>
		<NoriSentryEnvironment Condition="'$(NoriSentryEnvironment)' == ''">production</NoriSentryEnvironment>
		<!-- 基础分发不携带 Playwright 的 Node/JS driver；需要制作实验性全量包时可显式设为 true。 -->
		<NoriBundlePlaywrightRuntime Condition="'$(NoriBundlePlaywrightRuntime)' == ''">false</NoriBundlePlaywrightRuntime>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<!-- Nori 原生设置窗口使用 Devolutions 的跨平台 macOS 风格控件；该主题也提供 Windows/Linux 回退样式。 -->
		<PackageReference Include="Devolutions.AvaloniaTheme.MacOS" Version="2026.7.22" />
		<!-- 跨平台原生 WebView: Windows→WebView2, macOS→WKWebView, Linux→WebKitGTK -->
		<PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
		<PackageReference Include="Sentry" Version="6.9.0" />
		<!-- 浏览器自动化代码继续参与编译/测试；正式基础包会在 Publish 结束后剥离其重量级 driver/runtime。 -->
		<PackageReference Include="Microsoft.Playwright" Version="1.56.0" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nori.Desktop.Tests" />
		<ProjectReference Include="../Nori.Core/Nori.Core.csproj" />
		<ProjectReference Include="../Nori.PluginRuntime/Nori.PluginRuntime.csproj" />
		<ProjectReference Include="../Live2DCSharpSDK.OpenGL/Live2DCSharpSDK.OpenGL.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Cubism Core 原生库: 按 RID 只打包当前目标平台的一份 -->
		<None Include="../Live2D/native/win-x64/Live2DCubismCore.dll" Link="Live2DCubismCore.dll" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(NoriIsWindowsBuild)' == 'true')" />
		<None Include="../Live2D/native/linux-x64/libLive2DCubismCore.so" Link="libLive2DCubismCore.so" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))" />
		<None Include="../Live2D/native/macos/libLive2DCubismCore.dylib" Link="libLive2DCubismCore.dylib" CopyToOutputDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))" />
	</ItemGroup>

	<!--
		缺少目标平台的 Cubism Core 原生库时构建期就报错

		否则要等到运行时才炸 DllNotFoundException, 排查成本高得多。
		linux-arm64 官方 SDK 暂未提供, 需要自备后放到 Live2D/native/linux-arm64/。
	-->
	<Target Name="NoriCheckCubismCore" BeforeTargets="Build">
		<Error Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And !Exists('../Live2D/native/linux-arm64/libLive2DCubismCore.so')" Text="缺少 linux-arm64 的 Cubism Core 原生库: 请把 libLive2DCubismCore.so 放到 Live2D/native/linux-arm64/" />
		<Error Condition="'$(RuntimeIdentifier)' == 'linux-x64' And !Exists('../Live2D/native/linux-x64/libLive2DCubismCore.so')" Text="缺少 linux-x64 的 Cubism Core 原生库: Live2D/native/linux-x64/libLive2DCubismCore.so" />
		<Error Condition="($(RuntimeIdentifier.StartsWith('osx'))) And !Exists('../Live2D/native/macos/libLive2DCubismCore.dylib')" Text="缺少 macOS 的 Cubism Core 原生库: Live2D/native/macos/libLive2DCubismCore.dylib" />
	</Target>

	<ItemGroup>
		<AvaloniaResource Include="Assets/**" />
		<AvaloniaResource Include="../src/assets/images/live2D/Nori.webp" Link="Assets/Models/Nori.webp" />
		<AvaloniaResource Include="../src/assets/images/live2D/ARGNori.webp" Link="Assets/Models/ARGNori.webp" />
	</ItemGroup>

	<ItemGroup>
		<!-- 前端构建产物: 生产模式由 AssetServer 从这里提供 -->
		<Content Include="../dist/**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../dist')" />
	</ItemGroup>

	<!--
		Playwright NuGet 会把 .playwright/node、.playwright/package 与 playwright.ps1 自动标为发布内容。
		Nori 当前只使用系统已安装的 Edge，基础包不应该让这个实验性功能把所有平台的分发体积放大数倍。
		普通 Build/Test 仍保留这些文件；这里只在 Publish 完成后裁掉。若以后提供独立 Browser Automation
		Feature Pack，可用 -p:NoriBundlePlaywrightRuntime=true 制作包含 driver/runtime 的实验性包。
	-->
	<Target Name="NoriTrimPlaywrightRuntimeFromPublish" AfterTargets="Publish" Condition="'$(NoriBundlePlaywrightRuntime)' != 'true'">
		<PropertyGroup>
			<NoriPublishRoot>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</NoriPublishRoot>
		</PropertyGroup>
		<RemoveDir Directories="$(NoriPublishRoot).playwright" Condition="Exists('$(NoriPublishRoot).playwright')" />
		<Delete Files="$(NoriPublishRoot)playwright.ps1" Condition="Exists('$(NoriPublishRoot)playwright.ps1')" />
		<Error Condition="Exists('$(NoriPublishRoot).playwright')" Text="发布目录仍包含 .playwright；拒绝生成膨胀的基础分发包。" />
		<Error Condition="Exists('$(NoriPublishRoot)playwright.ps1')" Text="发布目录仍包含 playwright.ps1；Playwright runtime 裁剪未完成。" />
		<Message Importance="High" Text="Nori lean publish: 已排除 Playwright Node/JS runtime（可用 -p:NoriBundlePlaywrightRuntime=true 显式保留）。" />
	</Target>

	<!--
		Sentry DSN 是公有项目标识, 但不应写入仓库。发布时由 CI 通过 MSBuild 属性注入到中间生成文件;
		没有 DSN 时生成空字符串, SentryTelemetry 不创建客户端也不会联网。
	-->
	<Target Name="NoriGenerateSentryBuildConfig" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<NoriSentryGeneratedDir>$(IntermediateOutputPath)Generated</NoriSentryGeneratedDir>
			<NoriSentryGeneratedFile>$(NoriSentryGeneratedDir)SentryBuildConfig.g.cs</NoriSentryGeneratedFile>
		</PropertyGroup>
		<ItemGroup>
			<NoriSentryBuildConfigLines Include="namespace Nori.Desktop.Telemetry%3B" />
			<NoriSentryBuildConfigLines Include="internal static class SentryBuildConfig" />
			<NoriSentryBuildConfigLines Include="{" />
			<NoriSentryBuildConfigLines Include="&#x09;public const string NativeDsn = &quot;$(NoriSentryDsnNative)&quot;%3B" />
			<NoriSentryBuildConfigLines Include="&#x09;public const string Release = &quot;$(NoriSentryRelease)&quot;%3B" />
			<NoriSentryBuildConfigLines Include="&#x09;public const string Environment = &quot;$(NoriSentryEnvironment)&quot;%3B" />
			<NoriSentryBuildConfigLines Include="}" />
		</ItemGroup>
		<MakeDir Directories="$(NoriSentryGeneratedDir)" />
		<WriteLinesToFile File="$(NoriSentryGeneratedFile)" Lines="@(NoriSentryBuildConfigLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(NoriSentryGeneratedFile)" />
		</ItemGroup>
	</Target>

</Project>
