<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- 复用 Devolutions 控件模板、阴影与键盘焦点；统一 Nori 外壳及深色选项状态。 -->
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://Nori.Desktop/Appearance/NoriThemeResources.g.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<StaticResource x:Key="SettingsWindowBrush" ResourceKey="NoriBgBaseBrush"/>
			<StaticResource x:Key="SettingsSidebarBrush" ResourceKey="NoriBgSidebarBrush"/>
			<StaticResource x:Key="SettingsCardBrush" ResourceKey="NoriBgCardBrush"/>
			<StaticResource x:Key="SettingsBorderBrush" ResourceKey="NoriLineStrongBrush"/>
			<StaticResource x:Key="SettingsPrimaryBrush" ResourceKey="NoriTextPrimaryBrush"/>
			<StaticResource x:Key="SettingsSecondaryBrush" ResourceKey="NoriTextMutedBrush"/>
			<StaticResource x:Key="SettingsErrorBrush" ResourceKey="NoriDangerTextBrush"/>
			<StaticResource x:Key="SettingsSelectionBrush" ResourceKey="NoriBgSelectionBrush"/>
			<StaticResource x:Key="SettingsAccentBrush" ResourceKey="NoriNoriTealBrush"/>
			<StaticResource x:Key="SettingsInputBrush" ResourceKey="NoriBgInputBrush"/>
			<StaticResource x:Key="SettingsHoverBrush" ResourceKey="NoriBgCardHoverBrush"/>
			<StaticResource x:Key="SettingsAccentForegroundBrush" ResourceKey="NoriOnTealBrush"/>
			<StaticResource x:Key="SettingsIconForegroundBrush" ResourceKey="NoriTextMutedBrush"/>
			<StaticResource x:Key="SettingsIconHighlightBrush" ResourceKey="NoriOverlay20Brush"/>
			<StaticResource x:Key="NoriWindowSurfaceBrush" ResourceKey="NoriBgBaseBrush"/>
			<!-- Devolutions 的开关及下拉箭头拥有独立画刷，不继承控件前景。 -->
			<StaticResource x:Key="SystemAccentColor" ResourceKey="NoriNoriTealColor"/>
			<StaticResource x:Key="SystemAccentColorDark1" ResourceKey="NoriNoriTealPressedColor"/>
			<StaticResource x:Key="SystemAccentColorLight1" ResourceKey="NoriNoriTealBrightColor"/>
			<StaticResource x:Key="AccentForegroundColor" ResourceKey="NoriOnTealColor"/>
			<StaticResource x:Key="ControlBorderAccentBrush" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ControlBackgroundAccentHighBrush" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ControlBackgroundAccentRaisedBrush" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ControlForegroundAccentHighBrush" ResourceKey="SettingsAccentForegroundBrush"/>
			<StaticResource x:Key="FocusBorderBrush" ResourceKey="NoriWindowFocusGlowBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerCheckedDefaultBackground" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerCheckedPointeroverBackground" ResourceKey="NoriNoriTealBrightBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerCheckedPressedBackground" ResourceKey="NoriNoriTealPressedBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerCheckedDisabledBackground" ResourceKey="SettingsSelectionBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerUnCheckedDefaultBackground" ResourceKey="SettingsInputBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground" ResourceKey="SettingsHoverBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerUnCheckedPressedBackground" ResourceKey="SettingsSelectionBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerUnCheckedDisabledBackground" ResourceKey="SettingsCardBrush"/>
			<StaticResource x:Key="ToggleSwitchContainerUnCheckedDisabledBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="ToggleSwitchDefaultBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="ToggleSwitchKnobBackground" ResourceKey="SettingsPrimaryBrush"/>
			<StaticResource x:Key="SimpleToggleSwitchContainerCheckedForeground" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ComboBoxButtonBackgroundBrush" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ComboBoxButtonBorderBrush" ResourceKey="SettingsAccentBrush"/>
			<StaticResource x:Key="ComboBoxButtonInactiveBackgroundBrush" ResourceKey="SettingsInputBrush"/>
			<StaticResource x:Key="ComboBoxButtonInactiveBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="ComboBoxChevronBrush" ResourceKey="SettingsAccentForegroundBrush"/>
			<StaticResource x:Key="ComboBoxChevronInactiveBrush" ResourceKey="SettingsSecondaryBrush"/>
			<SolidColorBrush x:Key="TextBoxSelectionHighlightBrush" Color="{StaticResource NoriNoriTealColor}" Opacity="0.3"/>
			<CornerRadius x:Key="TextBoxFocusCornerRadius">8</CornerRadius>
			<StaticResource x:Key="ForegroundHighBrush" ResourceKey="SettingsPrimaryBrush"/>
			<StaticResource x:Key="ForegroundLowBrush" ResourceKey="SettingsSecondaryBrush"/>
			<StaticResource x:Key="ButtonBackgroundBrush" ResourceKey="SettingsInputBrush"/>
			<StaticResource x:Key="ButtonPressedBackgroundBrush" ResourceKey="SettingsHoverBrush"/>
			<StaticResource x:Key="ButtonDisabledBackgroundBrush" ResourceKey="SettingsCardBrush"/>
			<StaticResource x:Key="ButtonBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="ComboBoxBackgroundBrush" ResourceKey="SettingsInputBrush"/>
			<StaticResource x:Key="ComboBoxPressedBackgroundBrush" ResourceKey="SettingsHoverBrush"/>
			<StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="ControlBackgroundDisabledHighBrush" ResourceKey="SettingsCardBrush"/>
			<!-- 弹层与非活动选项同样需要深色底，不能只修复收起时的输入框。 -->
			<StaticResource x:Key="PopupBackgroundBrush" ResourceKey="SettingsCardBrush"/>
			<StaticResource x:Key="PopupBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="PopupInnerBorderHighlightBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="LayoutBackgroundMidBrush" ResourceKey="SettingsSelectionBrush"/>
			<StaticResource x:Key="ComboBoxItemPointerOverBackgroundBrush" ResourceKey="SettingsHoverBrush"/>
			<StaticResource x:Key="TextBoxBackgroundBrush" ResourceKey="SettingsInputBrush"/>
			<StaticResource x:Key="TextBoxBorderBrush" ResourceKey="SettingsBorderBrush"/>
			<StaticResource x:Key="TextBoxMultiLineBackgroundBrush" ResourceKey="SettingsInputBrush"/>
			<!-- 保留 ToggleButton 的选中语义，复用设置按钮模板及键盘焦点，不混用浅色回退模板。 -->
			<ControlTheme x:Key="SettingsChoiceTheme" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
				<Setter Property="Background" Value="{DynamicResource SettingsInputBrush}"/>
				<Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
				<Setter Property="BorderThickness" Value="1"/>
				<Setter Property="CornerRadius" Value="8"/>
				<Style Selector="^:pointerover, ^:pressed">
					<Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}"/>
				</Style>
				<Style Selector="^:checked">
					<Setter Property="Background" Value="{DynamicResource SettingsSelectionBrush}"/>
					<Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</Style>
				<Style Selector="^:disabled">
					<Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
					<Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryBrush}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/>
				</Style>
			</ControlTheme>
		</ResourceDictionary>
	</Styles.Resources>
	<Style Selector="Window">
		<Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Background" Value="{DynamicResource NoriWindowSurfaceBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBrush}"/>
	</Style>
	<Style Selector="ToggleButton.settings-choice">
		<Setter Property="Theme" Value="{StaticResource SettingsChoiceTheme}"/>
	</Style>
	<Style Selector="TextBox:not(.chat-composer):not(.quick-composer), ComboBox">
		<Setter Property="CornerRadius" Value="8"/>
	</Style>
	<Style Selector="Window.models-window ComboBox, Window.models-window TextBox">
		<Setter Property="MinHeight" Value="34"/>
		<Setter Property="FontSize" Value="13"/>
	</Style>
	<Style Selector="Button.danger:not(:disabled)">
		<Setter Property="Foreground" Value="{DynamicResource SettingsErrorBrush}"/>
	</Style>
	<Style Selector="Button.settings-nav">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryBrush}"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
	</Style>
	<!-- 导航是列表行而非浮起的按钮，仅在此处去除库的按钮阴影。 -->
	<Style Selector="Button.settings-nav /template/ Border#BackgroundElement">
		<Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
	</Style>
	<Style Selector="Button.settings-nav.selected">
		<Setter Property="Background" Value="{DynamicResource SettingsSelectionBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>
	<Style Selector="Button.settings-nav:pointerover">
		<Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBrush}"/>
	</Style>
	<Style Selector="Button.settings-nav.selected:pointerover">
		<Setter Property="Background" Value="{DynamicResource SettingsSelectionBrush}"/>
		<Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/>
	</Style>
	<Style Selector="TextBox.settings-search">
		<Setter Property="CornerRadius" Value="8"/>
	</Style>
	<!-- 导航统一使用无底片的线性图标。 -->
	<Style Selector="Border.settings-nav-symbol">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>
	<!-- 独立绘制的圆端线条符号，固定 24 单位画布避免不同图标的视觉尺寸漂移。 -->
	<Style Selector="Path.settings-nav-icon">
		<Setter Property="Width" Value="24"/>
		<Setter Property="Height" Value="24"/>
		<Setter Property="Stroke" Value="{DynamicResource SettingsIconForegroundBrush}"/>
		<Setter Property="StrokeThickness" Value="1.8"/>
		<Setter Property="StrokeLineCap" Value="Round"/>
		<Setter Property="StrokeJoin" Value="Round"/>
	</Style>
	<Style Selector="Button.settings-nav.selected Path.settings-nav-icon">
		<Setter Property="Stroke" Value="{DynamicResource SettingsAccentBrush}"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=ai] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 10,3 Q 11,10 18,11 Q 11,12 10,19 Q 9,12 2,11 Q 9,10 10,3 Z M 19,2 L 19,6 M 17,4 L 21,4 M 20,16 L 20,20 M 18,18 L 22,18"/>
	</Style>
	<!-- 每个导航入口都有独立路径数据。 -->
	<Style Selector="Button.settings-nav[Tag=workspace] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 12,3.2 L 4.8,6 L 4.8,12.1 C 4.8,16 7.7,19 12,20.8 C 16.3,19 19.2,16 19.2,12.1 L 19.2,6 Z M 9.1,12.2 L 11.3,14.4 L 15,10.4"/>
	</Style>
	<!-- 情绪表达改的都是颜色: 托盘图标、气泡描边、系统强调色。所以画一滴颜料。 -->
	<Style Selector="Button.settings-nav[Tag=expression] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 12,3.6 C 15.4,7.8 17.2,10.5 17.2,12.7 A 5.2,5.2 0 0 1 6.8,12.7 C 6.8,10.5 8.6,7.8 12,3.6 Z"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=voice] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 9,6 A 3,3 0 0 1 15,6 L 15,12 A 3,3 0 0 1 9,12 Z M 6,11 L 6,12 A 6,6 0 0 0 18,12 L 18,11 M 12,18 L 12,21 M 9,21 L 15,21"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=proactive] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 5,17 Q 7,14 7,9 A 5,5 0 0 1 17,9 Q 17,14 19,17 Z M 10,20 Q 12,22 14,20 M 12,2 L 12,4"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=general] Path.settings-nav-icon, Button.settings-nav[Tag=behaviors] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 4,6 L 12,6 M 16,6 L 20,6 M 4,12 L 7,12 M 11,12 L 20,12 M 4,18 L 13,18 M 17,18 L 20,18 M 16,6 A 2,2 0 1 1 12,6 A 2,2 0 1 1 16,6 M 11,12 A 2,2 0 1 1 7,12 A 2,2 0 1 1 11,12 M 17,18 A 2,2 0 1 1 13,18 A 2,2 0 1 1 17,18"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=updates] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 20,9 A 8,8 0 1 0 20,15 M 20,4 L 20,9 15,9 M 12,7 L 12,17 M 8,13 L 12,17 16,13"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=about] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 21,12 A 9,9 0 1 1 3,12 A 9,9 0 1 1 21,12 M 12,7 L 12,7.2 M 11,11 L 12,11 12,17 M 10,17 L 14,17"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=skills] Path.settings-nav-icon, Button.settings-nav[Tag=library] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 4,5 Q 8,3 12,6 Q 16,3 20,5 L 20,19 Q 16,17 12,20 Q 8,17 4,19 Z M 12,6 L 12,20 M 7,8 L 9,9 M 7,12 L 9,13 M 15,9 L 17,8 M 15,13 L 17,12"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=mcp] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 9,3 L 15,3 15,9 9,9 Z M 3,16 L 9,16 9,22 3,22 Z M 15,16 L 21,16 21,22 15,22 Z M 12,9 L 12,12 M 6,16 L 6,12 18,12 18,16"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=automation] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 13,2 L 5,13 11,13 10,22 19,10 13,10 Z"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=plugins] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 8,3 L 8,8 M 16,3 L 16,8 M 6,8 L 18,8 18,11 A 6,6 0 0 1 6,11 Z M 12,17 L 12,21"/>
	</Style>
	<Style Selector="Button.settings-nav[Tag=debug] Path.settings-nav-icon">
		<Setter Property="Data" Value="M 5,4 L 19,4 Q 21,4 21,6 L 21,18 Q 21,20 19,20 L 5,20 Q 3,20 3,18 L 3,6 Q 3,4 5,4 Z M 7,8 L 11,12 7,16 M 13,16 L 17,16"/>
	</Style>
	<!-- 选项模板有自己的选中前景，不能沿用强调按钮的深色字。 -->
	<Style Selector="ComboBoxItem /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Foreground" Value="{DynamicResource SettingsPrimaryBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:selected /template/ Border#RootPanel">
		<Setter Property="Background" Value="{DynamicResource SettingsSelectionBrush}"/>
	</Style>
	<Style Selector="ComboBoxItem:pointerover /template/ Border#RootPanel">
		<Setter Property="Background" Value="{DynamicResource SettingsHoverBrush}"/>
	</Style>
</Styles>
