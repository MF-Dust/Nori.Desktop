<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:settings="using:Nori.Desktop.Settings"
	x:Class="Nori.Desktop.Windows.SettingsWindow"
	x:CompileBindings="True"
	x:DataType="settings:SettingsViewModel"
	Title="{Binding WindowTitle}"
	Width="960"
	Height="640"
	MinWidth="720"
	MinHeight="480"
	CanResize="True"
	WindowStartupLocation="CenterScreen"
	WindowDecorations="Full"
	RequestedThemeVariant="Default">
	<Window.Styles>
		<StyleInclude Source="avares://Nori.Desktop/Settings/SettingsTheme.axaml"/>
	</Window.Styles>
	<Border Background="{DynamicResource SettingsWindowBrush}">
		<Grid ColumnDefinitions="192,*">
			<Border Grid.Column="0" Background="{DynamicResource SettingsSidebarBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,1,0">
				<DockPanel>
					<StackPanel DockPanel.Dock="Top" Spacing="16" Margin="18,22,18,14">
						<StackPanel Spacing="5">
							<TextBlock Text="NORI" FontSize="12" FontWeight="Bold" LetterSpacing="2" Foreground="{DynamicResource SettingsAccentBrush}"/>
							<TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
						</StackPanel>
						<TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding SearchPlaceholder}" MinHeight="34"/>
					</StackPanel>
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding FilteredGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="settings:SettingsGroupViewModel">
									<StackPanel Spacing="4" Margin="10,8,10,8">
										<TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SettingsSecondaryBrush}" Margin="6,2,0,3"/>
										<ItemsControl ItemsSource="{Binding VisiblePages}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="settings:SettingsPageItemViewModel">
													<Button Classes="settings-nav" Classes.selected="{Binding IsSelected}" Tag="{Binding Key}" Click="OnNavigateClick" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10,9" Margin="0,1" MinHeight="38" CornerRadius="8">
														<Grid ColumnDefinitions="16,*" ColumnSpacing="10">
															<PathIcon Classes="settings-nav-icon" VerticalAlignment="Center"/>
															<TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Border>
			<Grid Grid.Column="1" RowDefinitions="Auto,*">
				<Border Grid.Row="0" Background="{DynamicResource SettingsWindowBrush}" Padding="24,24,24,10">
					<StackPanel Spacing="4" MaxWidth="820" HorizontalAlignment="Stretch">
						<TextBlock Text="{Binding CurrentPageTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
						<TextBlock Text="{Binding CurrentPageDescription}" FontSize="13" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>
				<ScrollViewer x:Name="SettingsPageScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="24,14,24,28">
					<settings:SettingsPagePresenter x:Name="PagePresenter" DataContext="{Binding CurrentPage}" MaxWidth="820" HorizontalAlignment="Stretch"/>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Border>
</Window>
