<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:settings="using:Nori.Desktop.Settings"
	x:Class="Nori.Desktop.Windows.SettingsWindow"
	x:CompileBindings="True"
	x:DataType="settings:SettingsViewModel"
	Title="{Binding WindowTitle}"
	CanResize="True"
	WindowStartupLocation="CenterScreen"
	WindowDecorations="None"
	RequestedThemeVariant="Dark">
	<Window.Styles>
		<StyleInclude Source="avares://Nori.Desktop/Settings/SettingsTheme.axaml"/>
	</Window.Styles>
	<Border Background="Transparent">
		<Grid ColumnDefinitions="188,*">
			<Border Grid.Column="0" Background="{DynamicResource SettingsSidebarBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,1,0">
				<DockPanel>
					<StackPanel DockPanel.Dock="Top" Spacing="0" Margin="10,12,10,4">
						<TextBox Classes="settings-search" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding SearchPlaceholder}" AutomationProperties.Name="{Binding SearchPlaceholder}" MinHeight="32">
							<TextBox.InnerLeftContent>
								<PathIcon Width="13" Height="13" Margin="9,0,2,0" Foreground="{DynamicResource SettingsSecondaryBrush}" Data="M 6,0 A 6,6 0 1 0 6,12 A 6,6 0 0 0 6,0 Z M 6,2 A 4,4 0 1 1 6,10 A 4,4 0 0 1 6,2 Z M 10,11 L 11,10 16,15 15,16 Z"/>
							</TextBox.InnerLeftContent>
						</TextBox>
					</StackPanel>
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding FilteredGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="settings:SettingsGroupViewModel">
									<StackPanel Spacing="2" Margin="8,10,8,4">
										<TextBlock Text="{Binding Title}" FontSize="{DynamicResource NoriFontXs}" FontWeight="SemiBold" LetterSpacing="0.6" Foreground="{DynamicResource NoriTextFaintBrush}" Margin="10,4,0,4"/>
										<ItemsControl ItemsSource="{Binding VisiblePages}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="settings:SettingsPageItemViewModel">
													<Button Classes="settings-nav" Classes.selected="{Binding IsSelected}" Tag="{Binding Key}" Click="OnNavigateClick" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10,6" Margin="0" MinHeight="32" CornerRadius="{DynamicResource NoriRadiusSm}">
														<Grid ColumnDefinitions="16,*" ColumnSpacing="10">
															<Border Classes="settings-nav-symbol" Width="16" Height="16">
																<Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
																	<Path Classes="settings-nav-icon"/>
																</Viewbox>
															</Border>
															<TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
														</Grid>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Border>
			<Grid x:Name="SettingsPageBody" Grid.Column="1" RowDefinitions="Auto,*" ClipToBounds="True">
				<Border Grid.Row="0" Padding="28,22,28,14" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1">
					<StackPanel Spacing="4" MaxWidth="{Binding #PagePresenter.MaxWidth}" HorizontalAlignment="Stretch">
						<TextBlock Text="{Binding CurrentPageTitle}" FontSize="{DynamicResource NoriFont2xl}" FontWeight="SemiBold" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
						<TextBlock Text="{Binding CurrentPageDescription}" FontSize="{DynamicResource NoriFontXs}" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap"/>
						<TextBlock x:Name="SettingsSaveError" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" FontSize="{DynamicResource NoriFontBase}" Foreground="{DynamicResource SettingsErrorBrush}" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>
				<ScrollViewer x:Name="SettingsPageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Stretch" Padding="28,20,28,28">
					<settings:SettingsPagePresenter x:Name="PagePresenter" DataContext="{Binding CurrentPage}" HorizontalAlignment="Stretch"/>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Border>
</Window>
