<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:settings="using:Nori.Desktop.Settings"
	x:Class="Nori.Desktop.Windows.SettingsWindow"
	x:CompileBindings="True"
	x:DataType="settings:SettingsViewModel"
	Title="{Binding WindowTitle}"
	Width="960"
	Height="640"
	MinWidth="720"
	MinHeight="480"
	CanResize="True"
	WindowStartupLocation="CenterScreen"
	WindowDecorations="Full"
	RequestedThemeVariant="Default">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="SettingsWindowBrush" Color="#F6F7F9"/>
					<SolidColorBrush x:Key="SettingsSidebarBrush" Color="#ECEEF2"/>
					<SolidColorBrush x:Key="SettingsCardBrush" Color="#FFFFFF"/>
					<SolidColorBrush x:Key="SettingsBorderBrush" Color="#D9DCE2"/>
					<SolidColorBrush x:Key="SettingsPrimaryBrush" Color="#20242B"/>
					<SolidColorBrush x:Key="SettingsSecondaryBrush" Color="#626A78"/>
					<SolidColorBrush x:Key="SettingsErrorBrush" Color="#B42318"/>
					<SolidColorBrush x:Key="SettingsSelectionBrush" Color="#DCEBFF"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="SettingsWindowBrush" Color="#202227"/>
					<SolidColorBrush x:Key="SettingsSidebarBrush" Color="#191B1F"/>
					<SolidColorBrush x:Key="SettingsCardBrush" Color="#292C32"/>
					<SolidColorBrush x:Key="SettingsBorderBrush" Color="#3C414B"/>
					<SolidColorBrush x:Key="SettingsPrimaryBrush" Color="#F2F4F7"/>
					<SolidColorBrush x:Key="SettingsSecondaryBrush" Color="#A9B0BC"/>
					<SolidColorBrush x:Key="SettingsErrorBrush" Color="#FFB4AB"/>
					<SolidColorBrush x:Key="SettingsSelectionBrush" Color="#243B5B"/>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Window.Resources>
	<Border Background="{DynamicResource SettingsWindowBrush}">
		<Grid ColumnDefinitions="170,*">
			<Border Grid.Column="0" Background="{DynamicResource SettingsSidebarBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,1,0">
				<DockPanel>
					<StackPanel DockPanel.Dock="Top" Spacing="10" Margin="16,14,16,12">
						<TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
						<TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding SearchPlaceholder}" MinHeight="34"/>
					</StackPanel>
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
						<ItemsControl ItemsSource="{Binding FilteredGroups}">
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="settings:SettingsGroupViewModel">
									<StackPanel Spacing="3" Margin="12,8,10,4">
										<TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SettingsSecondaryBrush}" Margin="6,2,0,3"/>
										<ItemsControl ItemsSource="{Binding VisiblePages}">
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="settings:SettingsPageItemViewModel">
													<Button Tag="{Binding Key}" Click="OnNavigateClick" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="10,7" Margin="0,1">
														<TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</DockPanel>
			</Border>
			<Grid Grid.Column="1" RowDefinitions="Auto,*">
				<Border Grid.Row="0" Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
					<StackPanel Spacing="4">
						<TextBlock Text="{Binding CurrentPageTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SettingsPrimaryBrush}"/>
						<TextBlock Text="{Binding CurrentPageDescription}" FontSize="13" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap"/>
					</StackPanel>
				</Border>
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="24,16,0,0">
					<settings:SettingsPagePresenter x:Name="PagePresenter" DataContext="{Binding CurrentPage}"/>
				</ScrollViewer>
			</Grid>
		</Grid>
	</Border>
</Window>
