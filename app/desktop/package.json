		"@vueuse/core": "14.4.0",
		"dompurify": "3.4.14",
		"markdown-it": "15.0.0",
		"naive-ui": "^2.45.1",
		"vue": "^3.5.13",
		"vue-i18n": "^11.4.8",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@sentry/cli": "3.6.2",
		"@sentry/core": "10.70.0",
		"@sentry/vite-plugin": "5.4.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.4",
		"eslint-plugin-vue": "^10.10.0",
		"globals": "^17.11.0",
		"jsdom": "30.0.1",
