{
	"name": "nori-desktop-pet",
	"private": true,
	"description": "Nori Desktop - an open-source AI companion application",
	"license": "GPL-3.0",
	"author": "erhio, Nori, qicajie",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"theme:sync": "node scripts/sync-design-tokens.mjs",
		"theme:check": "node scripts/sync-design-tokens.mjs --check",
		"build": "tsc --noEmit && vite build",
		"lint": "eslint src --max-warnings=0",
		"preview": "vite preview",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"coverage:dotnet": "node scripts/coverage-dotnet.mjs",
		"check:todo": "node scripts/check-first-party-todos.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^9.39.4",
		"globals": "^17.11.0",
		"jsdom": "30.0.1",
		"typescript": "~5.6.2",
		"typescript-eslint": "^8.68.0",
		"vite": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
